{
  "mcp_config_example": "MCP 配置示例文件",
  "description": "此文件展示了如何配置 MCP 服务器，实际使用时需要根据具体 MCP 服务器进行调整",
  
  "mcp_servers": {
    "filesystem": {
      "command": "uvx",
      "args": ["fs-mcp"],
      "env": {
        "MCP_SERVER_FILESYSTEM_ROOT": "./"
      },
      "disabled": false,
      "autoApprove": ["read_file", "list_directory"]
    },
    
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "env": {
        "GIT_REPO_PATH": "."
      },
      "disabled": false,
      "autoApprove": ["git_status", "git_log", "git_diff"]
    },
    
    "config_server": {
      "command": "uvx",
      "args": ["mcp-configuration-manager"],
      "env": {
        "CONFIG_STORE_PATH": "./config_store"
      },
      "disabled": false,
      "autoApprove": ["get_config", "list_configs"]
    }
  },
  
  "usage_examples": {
    "environment_variables": {
      "MCP_ENABLED": "true",
      "MCP_CONFIG_SERVER": "config_server",
      "MCP_CONFIG_NAMESPACE": "agent-lab-production"
    },
    
    "config_hierarchy": {
      "priority": ["mcp_config", "environment_variables", "default_values"],
      "description": "配置获取优先级：MCP > 环境变量 > 默认值"
    }
  },
  
  "integration_steps": [
    "1. 安装 MCP 相关依赖: pip install fs-mcp mcp-server-git mcp-configuration-manager",
    "2. 设置环境变量启用 MCP: export MCP_ENABLED=true",
    "3. 配置 MCP 服务器地址: export MCP_CONFIG_SERVER=config_server",
    "4. 重启 Agent 服务以加载 MCP 配置"
  ]
}