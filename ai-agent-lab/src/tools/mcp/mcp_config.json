{
  "mcpServers": {
    "git": {
      "command": "mcp-server-git",
      "args": [],
      "env": {
        "GIT_REPO_PATH": "."
      },
      "disabled": false,
      "autoApprove": [
        "git_status",
        "git_log",
        "git_diff"
      ]
    },
    "postgresql": {
      "command": "mcp-server-postgresql",
      "args": [],
      "env": {
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "agent_lab",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": ""
      },
      "disabled": true,
      "autoApprove": [
        "query",
        "list_tables",
        "describe_table"
      ]
    },
    "hello-world": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/macsymwang/hello-mcp-server.git", "hello-mcp-server"],
      "env": {},
      "disabled": true,
      "autoApprove": ["say_hello", "get_server_info", "echo_message", "count_words"]
    }
  }
}